# FinanceAI backend — environment variables
# Copy to `.env` and fill in the secrets. See app/core/config.py for the schema.

# --- App ---
APP_ENV=development            # "development" or "production"
APP_VERSION=0.1.0

# --- PostgreSQL ---
POSTGRES_USER=finapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finapp
POSTGRES_HOST=postgres         # service name in docker-compose; "localhost" if running outside
POSTGRES_PORT=5432

# --- JWT ---
JWT_SECRET_KEY=                # generate: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth ---
# Two client IDs are accepted as audiences when verifying id_tokens.
GOOGLE_CLIENT_ID=              # Web Client ID (xxx.apps.googleusercontent.com)
GOOGLE_IOS_CLIENT_ID=          # iOS Client ID (yyy.apps.googleusercontent.com)

# --- Apple Sign In ---
APPLE_BUNDLE_ID=               # e.g. com.yourcompany.financeai

# --- Anthropic (AI) ---
ANTHROPIC_API_KEY=             # sk-ant-...

# AI safety: soft daily spend cap in USD across all users.
# When exceeded, /ai/command returns 503 and fires a Telegram alert.
AI_DAILY_BUDGET_USD=5.0

# --- Telegram logging ---
# Used for signup/login/first-tx/AI/payments/4xx-5xx notifications.
# Leave empty to disable Telegram notifications silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- RevenueCat ---
# Shared secret used to authenticate server-to-server webhooks.
REVENUECAT_WEBHOOK_SECRET=
# REST API v1 secret key (starts with "sk_") — used by POST /subscriptions/sync
# to pull authoritative subscription state. Never expose to clients.
REVENUECAT_REST_API_KEY=
